{
  "name": "agente-oc",
  "version": "0.1.0",
  "private": true,
  "description": "Agente conversacional para lectura, validación de controles y creación de órdenes de compra en un SAP simulado",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx demo.ts",
    "verify": "npm run typecheck && npm test && npm run demo"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.101",
    "@ai-sdk/react": "^4.0.172",
    "ai": "^7.0.168",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
