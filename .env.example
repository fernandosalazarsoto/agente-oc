# Copiar a .env.local para desarrollo. En Vercel se configuran como Environment Variables.
# Nunca subir valores reales al repositorio.

# Clave del proveedor LLM (solo servidor). Tests y demo.ts no la necesitan.
ANTHROPIC_API_KEY=

# Modelo del agente. Por defecto claude-sonnet-5-5; alternativa de menor costo: claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5

# Set de datos dentro de fixtures/ (maestros + solicitudes)
DATASET=reto-03

# Topes de costo (opcionales)
AGENT_MAX_ITERACIONES=12
AGENT_MAX_TOKENS_SESION=1000000
AGENT_MAX_TOKENS_SALIDA=1500
LLM_TIMEOUT_MS=25000

# Acceso básico opcional a la URL pública. Si se define la contraseña, se exige.
APP_ACCESS_USER=evaluador
APP_ACCESS_PASSWORD=

# Clave HMAC del estado de sesión que viaja con cada petición (32+ caracteres).
# Si no se define se usa TOOL_APPROVAL_SECRET; en local, una aleatoria por proceso.
SESSION_SECRET=
