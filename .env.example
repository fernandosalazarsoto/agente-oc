# Copiar a .env.local para desarrollo. En Vercel se configuran como Environment Variables.
# Nunca subir valores reales al repositorio.

# Clave del proveedor LLM (solo servidor)
ANTHROPIC_API_KEY=

# Modelo del agente en ejecución. Por defecto claude-sonnet-5-5.
# Alternativa de menor costo: claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5

# Secreto HMAC para firmar las aprobaciones humanas (mínimo 32 caracteres).
# Generar con: openssl rand -base64 32
# Obligatorio en producción: sin él la API rechaza las peticiones.
TOOL_APPROVAL_SECRET=

# Nombre del set de datos dentro de fixtures/ (maestros + solicitudes)
DATASET=ejemplo

# Acceso básico opcional a la URL pública. Si se define la contraseña, se exige.
APP_ACCESS_USER=evaluador
APP_ACCESS_PASSWORD=
